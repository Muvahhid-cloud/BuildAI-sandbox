{
  "name": "@buildai/schema",
  "version": "1.0.0",
  "private": true,
  "description": "GENERATED contracts (JSON Schema, TS types, Zod validator) from the Pydantic BuildingModel. Do not edit generated files by hand.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./building-model.schema.json": "./generated/building-model.schema.json"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "^5"
  }
}
